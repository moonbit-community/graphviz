///|
/// Decode the named entities used by Graphviz plain-text labels.
pub fn decode_label_entities(value : String) -> String {
  let mut decoded = value
  decoded = decoded.replace_all(old="&alpha;", new="α")
  decoded = decoded.replace_all(old="&beta;", new="β")
  decoded = decoded.replace_all(old="&gamma;", new="γ")
  decoded = decoded.replace_all(old="&delta;", new="δ")
  decoded = decoded.replace_all(old="&epsilon;", new="ε")
  decoded = decoded.replace_all(old="&zeta;", new="ζ")
  decoded = decoded.replace_all(old="&eta;", new="η")
  decoded = decoded.replace_all(old="&theta;", new="θ")
  decoded = decoded.replace_all(old="&iota;", new="ι")
  decoded = decoded.replace_all(old="&kappa;", new="κ")
  decoded = decoded.replace_all(old="&lambda;", new="λ")
  decoded = decoded.replace_all(old="&mu;", new="μ")
  decoded = decoded.replace_all(old="&nu;", new="ν")
  decoded = decoded.replace_all(old="&xi;", new="ξ")
  decoded = decoded.replace_all(old="&omicron;", new="ο")
  decoded = decoded.replace_all(old="&pi;", new="π")
  decoded = decoded.replace_all(old="&rho;", new="ρ")
  decoded = decoded.replace_all(old="&sigmaf;", new="ς")
  decoded = decoded.replace_all(old="&sigma;", new="σ")
  decoded = decoded.replace_all(old="&tau;", new="τ")
  decoded = decoded.replace_all(old="&upsilon;", new="υ")
  decoded = decoded.replace_all(old="&phi;", new="φ")
  decoded = decoded.replace_all(old="&chi;", new="χ")
  decoded = decoded.replace_all(old="&psi;", new="ψ")
  decoded = decoded.replace_all(old="&omega;", new="ω")
  decoded = decoded.replace_all(old="&upsih;", new="ϒ")
  decoded = decoded.replace_all(old="&piv;", new="ϖ")
  decoded = decoded.replace_all(old="&forall;", new="∀")
  decoded = decoded.replace_all(old="&part;", new="∂")
  decoded = decoded.replace_all(old="&exist;", new="∃")
  decoded = decoded.replace_all(old="&empty;", new="∅")
  decoded = decoded.replace_all(old="&nabla;", new="∇")
  decoded = decoded.replace_all(old="&isin;", new="∈")
  decoded = decoded.replace_all(old="&notin;", new="∉")
  decoded = decoded.replace_all(old="&ni;", new="∋")
  decoded = decoded.replace_all(old="&prod;", new="∏")
  decoded = decoded.replace_all(old="&sum;", new="∑")
  decoded = decoded.replace_all(old="&lowast;", new="∗")
  decoded = decoded.replace_all(old="&radic;", new="√")
  decoded = decoded.replace_all(old="&prop;", new="∝")
  decoded = decoded.replace_all(old="&infin;", new="∞")
  decoded = decoded.replace_all(old="&dagger;", new="†")
  decoded = decoded.replace_all(old="&nbsp;", new=" ")
  decoded = decoded.replace_all(old="&quot;", new="\"")
  decoded = decoded.replace_all(old="&gt;", new=">")
  decoded = decoded.replace_all(old="&lt;", new="<")
  decoded.replace_all(old="&amp;", new="&")
}
