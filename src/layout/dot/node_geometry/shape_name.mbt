///|
/// Keep known builtins; unknown user shapes use Graphviz's box fallback.
/// This does not rewrite the source node's shape attribute.
fn geometry_shape_name(name : String) -> String {
  match name {
    ""
    | "box"
    | "rect"
    | "rectangle"
    | "polygon"
    | "ellipse"
    | "oval"
    | "circle"
    | "point"
    | "dot"
    | "egg"
    | "triangle"
    | "none"
    | "plaintext"
    | "plain"
    | "diamond"
    | "trapezium"
    | "parallelogram"
    | "house"
    | "pentagon"
    | "hexagon"
    | "septagon"
    | "octagon"
    | "note"
    | "tab"
    | "folder"
    | "box3d"
    | "component"
    | "cylinder"
    | "square"
    | "doublecircle"
    | "doubleoctagon"
    | "tripleoctagon"
    | "invtriangle"
    | "invtri"
    | "invtrapezium"
    | "invhouse"
    | "underline"
    | "mdiamond"
    | "msquare"
    | "mcircle"
    | "promoter"
    | "cds"
    | "terminator"
    | "utr"
    | "insulator"
    | "ribosite"
    | "rnastab"
    | "proteasesite"
    | "proteinstab"
    | "primersite"
    | "restrictionsite"
    | "fivepoverhang"
    | "threepoverhang"
    | "noverhang"
    | "assembly"
    | "signature"
    | "rpromoter"
    | "larrow"
    | "rarrow"
    | "lpromoter"
    | "record"
    | "mrecord"
    | "epsf"
    | "star" => name
    _ => "box"
  }
}
