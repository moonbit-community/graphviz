  let graph = new_graph()
  for seed in node_seeds {
    let kind = match seed.0 {
      0 => NodeKind::Normal
      1 => NodeKind::Virtual
      _ => NodeKind::Slack
    }
    let idx = add_node(graph, "", kind~)
    set_node_rank(graph, idx, seed.1)
  }
  for seed in edge_seeds {
    ignore(add_edge(graph, seed.0, seed.1, seed.2, seed.3))
  }
  network_simplex(graph, 0x7fffffff, BalanceMode::LR)
  for idx, seed in node_seeds {
    assert_eq(node_rank(graph, idx), seed.2)
  }
}
